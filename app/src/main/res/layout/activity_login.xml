<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090E1D">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="44dp"
            android:paddingEnd="22dp"
            android:paddingBottom="36dp">

            <FrameLayout
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:background="@drawable/bg_logo_frame"
                android:elevation="12dp">
                <ImageView
                    android:id="@+id/logoGlow"
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:alpha="0.7"
                    android:background="@drawable/bg_logo_frame"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerInside" />
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_logo_frame"
                    android:clipToOutline="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo" />
            </FrameLayout>

            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.12"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/premium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Secure access to your dashboard"
                android:textColor="#9AA6C1"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_login_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WELCOME BACK"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Enter your access key to continue"
                    android:textColor="#9AA6C1"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="13dp">

                    <EditText
                        android:id="@+id/userkey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="License key"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#687594"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/eyeToggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:alpha="0.65"
                        android:clickable="true"
                        android:contentDescription="Show or hide key"
                        android:focusable="true"
                        android:src="@drawable/ic_eye"
                        app:tint="#D8DEEF" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/login"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_red_action"
                    android:text="LOGIN NOW"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
