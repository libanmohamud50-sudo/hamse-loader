<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090E1D">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="34dp"
            android:paddingEnd="18dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:id="@+id/brandHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/logoFrame"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:background="@drawable/bg_logo_frame"
                    android:elevation="12dp">
                    <ImageView
                        android:id="@+id/logoGlow"
                        android:layout_width="108dp"
                        android:layout_height="108dp"
                        android:alpha="0.7"
                        android:background="@drawable/bg_logo_frame"
                        android:contentDescription="@string/app_name" />
                    <ImageView
                        android:id="@+id/mainLogo"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_logo_frame"
                        android:clipToOutline="true"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo" />
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:letterSpacing="0.12"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/appVersionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Secure control panel"
                    android:textColor="#8490AD"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_login_card"
                android:elevation="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">
                <ImageView
                    android:id="@+id/gameIcon"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:contentDescription="BGMI India"
                    android:background="@drawable/bg_logo_frame"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bgmi" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/gameName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BGMI INDIA" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/packageName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="com.pubg.imobile" android:textColor="#8490AD" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/startBgmi"
                    android:layout_width="112dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_red_action"
                    android:text="LAUNCH"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </LinearLayout>
            <TextView android:id="@+id/startText" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ImageView android:id="@+id/actionIcon" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            <LinearLayout
                android:id="@+id/statusToggle"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_card"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <ProgressBar android:id="@+id/statusLoader" android:layout_width="18dp" android:layout_height="18dp" android:visibility="gone" android:indeterminateTint="#6C63FF" />
                <ImageView android:id="@+id/statusErrorIcon" android:layout_width="18dp" android:layout_height="18dp" android:visibility="gone" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="STATUS" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/statusToggleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAFE" android:textColor="#48D597" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/gameStatus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="ACCESS TIME" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.12" />
            <LinearLayout android:id="@+id/keyTimeRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:orientation="horizontal">
                <include layout="@layout/item_time_box" android:id="@+id/daysBox" />
                <include layout="@layout/item_time_box" android:id="@+id/hoursBox" android:layout_marginStart="8dp" />
                <include layout="@layout/item_time_box" android:id="@+id/minutesBox" android:layout_marginStart="8dp" />
                <include layout="@layout/item_time_box" android:id="@+id/secondsBox" android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="FEEDBACK" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.12" />
            <LinearLayout android:id="@+id/fbCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/startFB" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:background="@drawable/bg_login_card"  android:drawablePadding="9dp" android:gravity="center_vertical|start" android:paddingStart="15dp" android:text="SEND FEEDBACK" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:stateListAnimator="@null" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/obbButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_login_card" android:drawableStart="@drawable/ic_facebook_logo" android:drawablePadding="9dp" android:gravity="center_vertical|start" android:paddingStart="15dp" android:text="FACEBOOK" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:stateListAnimator="@null" />
            </LinearLayout>

            <LinearLayout android:id="@+id/downloadBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_login_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp" android:visibility="gone">
                <ProgressBar android:id="@+id/downloadProgressBar" android:layout_width="34dp" android:layout_height="34dp" android:indeterminateTint="#6C63FF" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/downloadStatusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Preparing..." android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Please wait while we finish" android:textColor="#8490AD" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:id="@+id/percentText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WAIT" android:textColor="#6C63FF" android:textSize="14sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/loadingCursor" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/restartButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/bg_login_card" android:text="CLEAR DATA" android:textColor="#8490AD" android:textSize="13sp" android:stateListAnimator="@null" android:visibility="visible" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
